{
  "reps": 1,
  "seed": 1,
  "conditions": ["foreground", "background"],
  "pattern": "{*-1*,cross-*}",
  "maxTrialsPerJob": 22,
  "validate": { "runs": 1 },
  "envs": [
    {
      "id": "ubuntu-24.04",
      "os": "linux",
      "runner": "ubuntu-24.04",
      "machine": "gha-ubuntu-24.04-x11",
      "kind": "host",
      "display": "x11"
    },
    {
      "id": "debian-13",
      "os": "linux",
      "runner": "ubuntu-24.04",
      "machine": "debian-13",
      "kind": "container",
      "display": "x11",
      "image": "debian:trixie"
    },
    {
      "id": "nixos-25.05",
      "os": "linux",
      "runner": "ubuntu-24.04",
      "machine": "nixos-25.05",
      "kind": "vm",
      "display": "wayland"
    },
    {
      "id": "omarchy-v3.8.4",
      "os": "linux",
      "runner": "ubuntu-24.04",
      "machine": "omarchy-v3.8.4",
      "kind": "vm",
      "display": "wayland"
    },
    {
      "id": "macos-15",
      "os": "macos",
      "runner": "macos-15",
      "machine": "macos-15",
      "kind": "host",
      "display": "aqua"
    }
  ],
  "tracks": [
    {
      "track": "terminal",
      "os": ["linux", "macos"],
      "contenders": [
        { "name": "kiko", "models": ["iceman-contributor-free"] },
        { "name": "baseline-shell", "models": ["iceman-contributor-free"] }
      ]
    },
    {
      "track": "terminal",
      "os": ["linux", "macos"],
      "envs": ["ubuntu-24.04", "macos-15"],
      "contenders": [{ "name": "kiko-remote", "models": ["iceman-contributor-free"] }]
    },
    {
      "track": "browser",
      "os": ["linux", "macos"],
      "contenders": [
        { "name": "kiko", "models": ["iceman-contributor-free"] },
        { "name": "agent-browser", "models": ["iceman-contributor-free"] }
      ]
    },
    {
      "track": "desktop",
      "os": ["linux", "macos"],
      "contenders": [{ "name": "kiko", "models": ["iceman-contributor-free"] }]
    },
    {
      "track": "desktop",
      "os": ["linux"],
      "envs": ["ubuntu-24.04", "debian-13", "nixos-25.05", "omarchy-v3.8.4"],
      "contenders": [
        { "name": "cua-driver", "models": ["iceman-contributor-free"] },
        { "name": "agent-desktop", "models": ["iceman-contributor-free"] }
      ]
    },
    {
      "track": "cross",
      "os": ["linux", "macos"],
      "contenders": [{ "name": "kiko", "models": ["iceman-contributor-free"] }]
    }
  ],
  "skips": [
    {
      "contender": "baseline-shell",
      "tracks": ["browser", "desktop", "cross"],
      "reason": "one bash tool; it has no browser, desktop or file-reading tool, so it could only score 0 for a harness reason"
    },
    {
      "contender": "agent-browser",
      "tracks": ["terminal", "desktop", "cross"],
      "reason": "browser tools only; it has no shell or desktop tool"
    },
    {
      "contender": "cua-driver",
      "tracks": ["terminal", "browser", "cross"],
      "reason": "desktop tools only; it has no shell, browser or file-reading tool"
    },
    {
      "contender": "agent-desktop",
      "tracks": ["terminal", "browser", "cross"],
      "reason": "desktop tools only; it has no shell, browser or file-reading tool"
    },
    {
      "contender": "cua-driver",
      "tracks": ["desktop"],
      "envs": ["macos-15"],
      "reason": "bench.yml installs and grants Accessibility to cua-driver only on Linux; the macOS smoke lives in bench-contenders.yml"
    },
    {
      "contender": "agent-desktop",
      "tracks": ["desktop"],
      "envs": ["macos-15"],
      "reason": "bench.yml installs and grants Accessibility to agent-desktop only on Linux; the macOS smoke lives in bench-contenders.yml"
    },
    {
      "contender": "kiko-remote",
      "tracks": ["browser", "desktop", "cross"],
      "reason": "only the terminal track is wired for the remote path; browser and desktop run through the kiko contender instead"
    },
    {
      "contender": "kiko-remote",
      "tracks": ["terminal"],
      "envs": ["debian-13", "nixos-25.05", "omarchy-v3.8.4"],
      "reason": "it starts a local Worker and daemons; the real-Worker path is wired and green only on the two host runners (bench-real-path.yml)"
    }
  ]
}
