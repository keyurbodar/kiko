{
  "kiko": 1,
  "name": "decision-log",
  "version": "1.0.0",
  "description": "agents log each decision with its reason as a shared note, and always know the last five.",
  "tools": {
    "log_decision": {
      "description": "record a decision the human made or agreed to, with why",
      "effect": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "decision": { "type": "string" },
          "why": { "type": "string" }
        },
        "required": ["decision", "why"]
      }
    }
  },
  "calls": ["write_note"],
  "state": "room",
  "sections": { "recent": {} },
  "tests": [
    { "tool": "log_decision", "args": { "decision": "ship friday", "why": "qa is done" }, "calls": { "write_note": "saved" }, "expect": "logged decision 1" }
  ]
}
