{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiko",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web-solid/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "UserDO" },
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "AGENT", "class_name": "AgentDO" },
      // CPU-heavy job work, out of the queue consumer (architecture section 17.3).
      { "name": "WORK", "class_name": "WorkDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserDO", "RoomDO", "AgentDO"] },
    { "tag": "v2", "new_sqlite_classes": ["WorkDO"] }
  ],
  "d1_databases": [
    { "binding": "AUTH_DB", "database_name": "kiko-auth", "database_id": "6ca8b7aa-6428-4d81-ade5-ceab9cdf76fa" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "kiko-files" }],
  "kv_namespaces": [{ "binding": "PREVIEWS", "id": "fa5a6507f92b413a824f60f08b051483" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "kiko-jobs" }],
    // 100 is the Queues limit. A job that still fails goes to the dead-letter queue,
    // whose consumer sends account deletions back to kiko-jobs, so deletion never gives up.
    "consumers": [
      { "queue": "kiko-jobs", "max_batch_timeout": 1, "max_retries": 100, "dead_letter_queue": "kiko-jobs-dead" },
      { "queue": "kiko-jobs-dead", "max_batch_timeout": 1, "max_retries": 100 }
    ]
  }
}
