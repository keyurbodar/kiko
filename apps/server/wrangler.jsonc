{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiko",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web-solid/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/*", "/pc/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "OWNER", "class_name": "OwnerDO" }],
  },
  "migrations": [{ "tag": "v5", "new_sqlite_classes": ["OwnerDO"] }],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "kiko-files" },
    { "binding": "ARCHIVE", "bucket_name": "kiko-history" },
  ],
}
