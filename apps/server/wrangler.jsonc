{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiko",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web-solid/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "UserDO" },
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "AGENT", "class_name": "AgentDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserDO", "RoomDO", "AgentDO"] },
    { "tag": "v2", "new_sqlite_classes": ["WorkDO"] },
    // The attachment job and its WorkDO were removed on 2026-10-09 (architecture section 17.3).
    { "tag": "v3", "deleted_classes": ["WorkDO"] }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "kiko-files" }]
}
