{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["apps/*/src/**", "apps/web-solid/scripts/**", "packages/*/src/**", "core/*/src/**", "scripts/**", "!**/*.css", "!**/*.gen.ts"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnknownProperty": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "warn",
        "useTemplate": "warn"
      },
      "complexity": { "noForEach": "warn", "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 30 } } },
      "suspicious": {
        "noExplicitAny": "error",
        "noAssignInExpressions": "warn",
        "noControlCharactersInRegex": "warn",
        "noImplicitAnyLet": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useButtonType": "warn",
        "useFocusableInteractive": "warn",
        "useKeyWithClickEvents": "warn",
        "useMediaCaption": "warn",
        "useSemanticElements": "warn"
      }
    }
  }
}
