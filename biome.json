{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["apps/*/src/**", "packages/*/src/**", "core/*/src/**", "scripts/**", "!**/*.css", "!**/*.gen.ts"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "warn",
        "useTemplate": "warn"
      },
      "complexity": { "noForEach": "warn" },
      "suspicious": {
        "noExplicitAny": "warn",
        "noShadowRestrictedNames": "warn",
        "noAssignInExpressions": "warn",
        "noControlCharactersInRegex": "warn",
        "noImplicitAnyLet": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "noUnknownProperty": "off",
        "noVoidTypeReturn": "warn"
      },
      "a11y": {
        "noNoninteractiveElementToInteractiveRole": "warn",
        "noNoninteractiveTabindex": "warn",
        "useAriaActivedescendantWithTabindex": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useValidAriaRole": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useButtonType": "warn",
        "useFocusableInteractive": "warn",
        "useKeyWithClickEvents": "warn",
        "useMediaCaption": "warn",
        "useSemanticElements": "warn"
      }
    }
  }
}
