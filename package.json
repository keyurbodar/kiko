{
  "name": "kiko",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "core/*"
  ],
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev --port 8787",
    "dev:web": "bun run --cwd apps/web-solid dev --port 5173",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check",
    "check": "bun scripts/check.ts",
    "kiko": "bun apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@phosphor-icons/core": "2.1.1",
    "@resvg/resvg-js": "2.6.2"
  }
}
