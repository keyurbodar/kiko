{
  "name": "kiko",
  "version": "0.11.25",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "core/*",
    "infra",
    "oxlint-plugin-kiko"
  ],
  "type": "module",
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev --port 8787",
    "dev:web": "bun run --cwd apps/web-solid dev --port 5173",
    "kiko": "bun apps/cli/src/index.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings && biome check --diagnostic-level=error",
    "typecheck": "bun run --filter \"*\" typecheck",
    "knip": "knip --no-progress",
    "check": "bun run fmt:check && bun run lint && bun scripts/check-imports.ts && bun scripts/check-generated.ts && bun run knip && bun run typecheck",
    "check:changed": "bun scripts/check-changed.ts",
    "build": "bun run --cwd apps/web-solid build",
    "prepare": "git rev-parse --git-path hooks >/dev/null 2>&1 && hooks=\"$(git rev-parse --git-path hooks)\" && printf \"#!/bin/sh\\nexec bun scripts/format-staged.ts\\n\" > \"$hooks/pre-commit\" && printf \"#!/bin/sh\\nexec bun scripts/check-changed.ts\\n\" > \"$hooks/pre-push\" && chmod +x \"$hooks/pre-commit\" \"$hooks/pre-push\" || true",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@hugeicons/core-free-icons": "4.3.5",
    "@phosphor-icons/core": "2.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "vitest": "5.0.5"
  },
  "patchedDependencies": {
    "just-bash@3.6.0": "patches/just-bash@3.6.0.patch"
  }
}
