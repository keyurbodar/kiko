{
  "name": "@kiko/ui",
  "version": "0.0.1",
  "private": true,
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "src/components/provider-icons/sprite.svg"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./file-icon.css": "./src/components/file-icon.css",
    "./remix-icon": "./src/components/remix-icon.tsx",
    "./remix-icon.css": "./src/components/remix-icon.css",
    "./icons": "./src/icons.gen.ts",
    "./provider-icon.css": "./src/components/provider-icon.css",
    "./provider-icon": "./src/components/provider-icon.tsx",
    "./pictogram": "./src/components/pictogram.tsx",
    "./pictogram.css": "./src/components/pictogram.css",
    "./file-icon": "./src/components/file-icon.tsx",
    "./context/*": "./src/context/*.tsx",
    "./i18n/*": "./src/i18n/*.ts",
    "./v2/*.css": "./src/v2/components/*.css",
    "./v2/*": "./src/v2/components/*.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@kobalte/core": "0.13.11"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.8.2",
    "vite": "8.3.2"
  },
  "peerDependencies": {
    "solid-js": "1.9.17"
  }
}
