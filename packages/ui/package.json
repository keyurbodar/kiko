    "@solid-primitives/event-listener": "2.4.5",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.8.2",
    "vite": "8.3.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
