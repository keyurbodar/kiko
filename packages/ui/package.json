{
  "name": "@kiko/ui",
  "version": "0.0.1",
  "private": true,
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "src/components/file-icons/sprite.svg",
    "src/components/provider-icons/sprite.svg"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./file-icon.css": "./src/components/file-icon.css",
    "./icon.css": "./src/components/icon.css",
    "./icon": "./src/components/icon.tsx",
    "./remix-icon": "./src/components/remix-icon.tsx",
    "./icons": "./src/icons.gen.ts",
    "./provider-icon.css": "./src/components/provider-icon.css",
    "./provider-icon": "./src/components/provider-icon.tsx",
    "./file-icon": "./src/components/file-icon.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./context/*": "./src/context/*.tsx",
    "./i18n/*": "./src/i18n/*.ts",
    "./v2/*.css": "./src/v2/components/*.css",
    "./v2/tree/create-tree": "./src/v2/components/tree/create-tree.ts",
    "./v2/*": "./src/v2/components/*.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@headless-tree/core": "^1.7.0",
    "@kobalte/core": "0.13.11",
    "fuzzysort": "3.1.0",
    "remeda": "2.26.0",
    "solid-list": "0.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.8.2",
    "vite": "8.3.2"
  },
  "peerDependencies": {
    "solid-js": "1.9.17"
  }
}
