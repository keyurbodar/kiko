{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "types": "off",
    "nsTypes": "off"
  },
  "ignoreDependencies": ["cloudflare"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"]
    },
    "apps/server": {
      "entry": ["src/front-door.ts", "scripts/*.ts"]
    },
    "apps/web-solid": {
      "entry": ["src/main.tsx"]
    },
    "packages/theme": {
      "entry": ["scripts/*.ts"]
    },
    "apps/computer": {
      "entry": ["scripts/*.ts"]
    },
    "apps/builder": {
      "entry": ["scripts/*.ts"]
    },
    "infra": {
      "entry": ["alchemy.run.ts"]
    }
  }
}
