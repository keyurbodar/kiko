{
  "yuki": 1,
  "name": "weather",
  "version": "1.0.0",
  "description": "the weather now and for the next days, anywhere, from Open-Meteo. no key needed.",
  "tools": {
    "weather": {
      "description": "the weather now and a short forecast for a place",
      "effect": "read",
      "parameters": {
        "type": "object",
        "properties": {
          "place": { "type": "string", "description": "a city or place, such as lisbon" },
          "days": { "type": "integer", "minimum": 1, "maximum": 7, "description": "forecast days, default 3" }
        },
        "required": ["place"]
      }
    }
  },
  "egress": ["geocoding-api.open-meteo.com", "api.open-meteo.com"],
  "tests": [
    {
      "tool": "weather",
      "args": { "place": "lisbon", "days": 1 },
      "fetch": {
        "status": 200,
        "body": {
          "results": [{ "name": "Lisbon", "country": "Portugal", "latitude": 38.7, "longitude": -9.1 }],
          "current": { "temperature_2m": 21.4, "apparent_temperature": 20.9, "weather_code": 1, "wind_speed_10m": 12 },
          "daily": { "time": ["2026-10-04"], "weather_code": [61], "temperature_2m_max": [23], "temperature_2m_min": [15], "precipitation_probability_max": [40] }
        }
      },
      "expect": "Lisbon, Portugal: 21°c"
    }
  ]
}
